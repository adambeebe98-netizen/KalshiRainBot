# Copy this file to .env and fill in real values. Never commit .env.

# --- Kalshi ---
# Verify the current base URL at https://docs.kalshi.com before trusting this.
KALSHI_BASE_URL=https://api.elections.kalshi.com/trade-api/v2
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=./kalshi_private_key.pem

# --- Anthropic (used only for parsing market rules text) ---
ANTHROPIC_API_KEY=

# --- Trading mode ---
# Must be "true" AND you must pass --live on the command line for real orders.
LIVE_TRADING=false
# Only needed if running --live under a headless process (systemd, etc) with
# no terminal to answer the confirmation prompt. Leave false until you've
# run --live manually at least once and trust the numbers.
LIVE_TRADING_CONFIRMED=false

# --- Bankroll / risk ---
STARTING_BANKROLL_CENTS=50000
MAX_POSITION_PCT=0.03
MAX_DAILY_LOSS_PCT=0.06
MIN_EDGE_CENTS=6
MIN_CONTRACT_PRICE_CENTS=2
MAX_CONTRACT_PRICE_CENTS=90
MAX_OPEN_POSITIONS=15

# --- Loop timing ---
POLL_INTERVAL_SECONDS=300
RULES_CACHE_PATH=rules_cache.json
DB_PATH=bot_state.db

# --- Market scope ---
# Comma-separated Kalshi series tickers, used only as a FALLBACK if
# AUTO_DISCOVER_SERIES fails or is turned off. Confirm exact series tickers
# in the Kalshi markets UI/API if you rely on this — these are illustrative,
# not guaranteed current.
SERIES_TICKERS=KXRAIN,KXHIGHTEMP

# When true (default), the bot discovers every currently-listed series
# whose ticker or title contains DISCOVERY_KEYWORD (e.g. every per-city
# rain series Kalshi currently has open) instead of relying on the fixed
# list above — so new or removed cities are picked up automatically.
AUTO_DISCOVER_SERIES=true
DISCOVERY_KEYWORDS=rain,KXHIGH,KXLOW
DISCOVERY_REFRESH_SECONDS=3600
