[Unit]
Description=Sports ground truth (ESPN): plays, revisions, win prob, odds
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/kalshi_weather_bot
Environment=PYTHONPATH=/root/kalshi_weather_bot
ExecStart=/root/kalshi_weather_bot/venv/bin/python -u sports_truth.py
Restart=always
RestartSec=15
StandardOutput=append:/root/kalshi_weather_bot/sports_truth.log
StandardError=append:/root/kalshi_weather_bot/sports_truth.log

[Install]
WantedBy=multi-user.target
